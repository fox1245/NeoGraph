{
  "version": 1,
  "family": "openai.chat",
  "case": "native",
  "mode": "runtime",
  "streaming": false,
  "warmup_requests": 10,
  "measured_requests": 100,
  "concurrency": 32,
  "process_repetitions": 3,
  "payload_bytes": 256,
  "server_delay_ms": 5,
  "workers": 1,
  "io_threads": 1,
  "resolver_threads": 1,
  "max_host_connections": 32,
  "max_operations": 64,
  "output_tokens": 64,
  "timeout_ms": 30000,
  "http_preference": "h1",
  "retry_enabled": false,
  "max_attempts": 1,
  "retain_results": true,
  "codec_iterations": 0,
  "node": "node",
  "peer_script": "../SchemaProvider/tools/benchmark_peer.mjs",
  "source_revision": "schema-provider-cutover-extended",
  "model_input_limit": 4096,
  "engine_workers": 1,
  "max_steps": 8,
  "model_token_budget": 0,
  "cancellation_requests": 8,
  "cancel_after_ms": 1
}
