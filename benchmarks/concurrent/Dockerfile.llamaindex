# LlamaIndex Workflow concurrent bench image.

FROM python:3.12-slim

RUN pip install --no-cache-dir llama-index-core==0.14.25 llama-index-workflows==2.26.0

WORKDIR /app
COPY benchmarks/concurrent/bench_concurrent_llamaindex.py /app/bench.py
COPY benchmarks/concurrent/burst_common.py /app/burst_common.py

ENTRYPOINT ["python", "-u", "/app/bench.py"]
