# NeoGraph concurrent bench image.
#
# Build from repo root:
#   docker build -t ng-concurrent -f benchmarks/concurrent/Dockerfile.neograph .

FROM ubuntu:24.04 AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        python3 \
        ca-certificates \
        libcurl4-openssl-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*
# Core's typed provider contracts require the SchemaProvider runtime, including
# curl >= 7.88 and OpenSSL, even when NeoGraph's optional network modules are OFF.
# Ubuntu 24.04 supplies the required curl; Python generates SDK embedded config.

WORKDIR /src
COPY . .

# The private consumer links neograph::core, inheriting the complete SDK link
# closure. SDK acquisition/pinning remains in NeoGraph's root CMake convention.
RUN cmake -S benchmarks/concurrent -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DNEOGRAPH_BUILD_ASYNC=OFF \
        -DNEOGRAPH_BUILD_PROGRAM=OFF \
        -DNEOGRAPH_BUILD_QUICKJS_CONTROL=OFF \
        -DNEOGRAPH_BUILD_LLM=OFF \
        -DNEOGRAPH_BUILD_MCP=OFF \
        -DNEOGRAPH_BUILD_MCP_CLIENT=OFF \
        -DNEOGRAPH_BUILD_MCP_SERVER=OFF \
        -DNEOGRAPH_BUILD_MCP_HTTP_SERVER=OFF \
        -DNEOGRAPH_BUILD_A2A=OFF \
        -DNEOGRAPH_BUILD_ACP=OFF \
        -DNEOGRAPH_BUILD_UTIL=OFF \
        -DNEOGRAPH_BUILD_POSTGRES=OFF \
        -DNEOGRAPH_BUILD_SQLITE=OFF \
        -DNEOGRAPH_BUILD_EXAMPLES=OFF \
        -DNEOGRAPH_BUILD_TESTS=OFF \
        -DNEOGRAPH_BUILD_PYBIND=OFF \
        -DNEOGRAPH_BUILD_GRPC=OFF \
        -DBUILD_SHARED_LIBS=OFF \
        -DNEOGRAPH_USE_LIBCURL=OFF \
    && cmake --build build --target bench_ng -j \
    && install build/bench_ng /usr/local/bin/bench_ng

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
        ca-certificates \
        libcurl4t64 \
        libssl3t64 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/bench_ng /usr/local/bin/bench_ng

ENTRYPOINT ["/usr/local/bin/bench_ng"]
