{
  "name": "veo",
  "connection": {
    "base_url": "https://generativelanguage.googleapis.com",
    "endpoint": "/v1beta/models/$MODEL:predictLongRunning",
    "auth_header": "x-goog-api-key",
    "api_key_env": "GEMINI_API_KEY"
  },
  "request": {
    "model_field": "",
    "prompt_template": {"instances": [{"prompt": "$PROMPT"}]},
    "temperature_path": null,
    "max_tokens_path": "",
    "stream_field": "",
    "extra_fields": {},
    "per_call_fields": ["parameters.aspectRatio", "parameters.personGeneration", "parameters.durationSeconds", "parameters.resolution"]
  },
  "operation": {
    "id_path": "name",
    "done_path": "done",
    "error_path": "error",
    "poll_endpoint": "/v1beta/$OPERATION",
    "poll_method": "GET",
    "poll_interval_ms": 1000,
    "result_path": "response"
  },
  "response": {
    "strategy": "output_array",
    "output_path": "output",
    "default_stop_reason": "end_turn",
    "artifacts": [{
      "items_path": "generateVideoResponse.generatedSamples",
      "mime_type": "video/mp4",
      "kind": "video",
      "mime_path": "video.mimeType",
      "url_path": "video.uri",
      "file_id_path": "video.fileId",
      "metadata_path": "video"
    }]
  }
}
