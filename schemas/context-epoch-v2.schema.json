{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/context-epoch-v2.schema.json",
  "title": "NeoGraph ContextEpoch stored value v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "storage_schema_version", "id", "run_id", "sequence", "feed_id", "raw_from_sequence", "raw_through_sequence", "raw_window_digest", "artifact_ids", "guarantee_profile"],
  "properties": {
    "format": { "const": "neograph-context-epoch" },
    "storage_schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/sha256" },
    "run_id": { "$ref": "#/$defs/token" },
    "sequence": { "type": "integer", "minimum": 1 },
    "predecessor_id": { "$ref": "#/$defs/sha256" },
    "feed_id": { "type": "string" },
    "raw_from_sequence": { "type": "integer", "minimum": 0 },
    "raw_through_sequence": { "type": "integer", "minimum": 0 },
    "raw_window_digest": { "$ref": "#/$defs/sha256" },
    "artifact_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "guarantee_profile": { "enum": ["legacy", "recorded", "strict"] },
    "ordered_artifact_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
    "prefix_claim": { "enum": ["extends", "breaks"] },
    "break_reason": { "enum": ["compaction", "stable_change", "layout_change", "anchor_drop", "order_change", "explicit"] },
    "assembly_layout": { "const": "stable_first" }
  },
  "anyOf": [
    { "required": ["ordered_artifact_ids"] },
    { "required": ["prefix_claim"] },
    { "required": ["break_reason"] },
    { "required": ["assembly_layout"] }
  ],
  "allOf": [
    {
      "if": { "properties": { "sequence": { "const": 1 } }, "required": ["sequence"] },
      "then": { "not": { "required": ["predecessor_id"] } },
      "else": { "required": ["predecessor_id"] }
    },
    {
      "if": { "required": ["assembly_layout"] },
      "then": { "required": ["ordered_artifact_ids"] }
    },
    {
      "if": { "properties": { "prefix_claim": { "const": "extends" } }, "required": ["prefix_claim"] },
      "then": { "required": ["ordered_artifact_ids", "predecessor_id"] }
    },
    {
      "if": { "properties": { "prefix_claim": { "const": "breaks" } }, "required": ["prefix_claim"] },
      "then": { "required": ["break_reason"] },
      "else": { "not": { "required": ["break_reason"] } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "token": { "type": "string", "pattern": "^[^\\u0000-\\u0020\\u007F](?:[^\\u0000-\\u001F\\u007F]*[^\\u0000-\\u0020\\u007F])?$" }
  }
}
