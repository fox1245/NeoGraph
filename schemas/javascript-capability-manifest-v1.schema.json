{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/javascript-capability-manifest-v1.schema.json",
  "title": "NeoGraph JavaScript authoring capability manifest v1",
  "description": "The value javascript_authoring_capability_manifest() returns: the builder and command vocabulary of define() and main(), feature flags, and the schemas that constrain generated programs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "javascript_profile",
    "javascript_profile_version",
    "ng_api_version",
    "features",
    "schemas",
    "dts_prelude",
    "define",
    "main",
    "structured_command_limits",
    "constraints"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "javascript_profile": { "$ref": "#/$defs/text" },
    "javascript_profile_version": { "$ref": "#/$defs/positive" },
    "ng_api_version": { "$ref": "#/$defs/positive" },
    "features": {
      "type": "object",
      "description": "One flag per authoring feature; true when this build compiles and runs it. A builder method of a feature that is off may still compile and validate its arguments.",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
      "additionalProperties": { "type": "boolean" },
      "required": [
        "graph.core",
        "graph.channels",
        "graph.conditional_edges",
        "graph.barrier",
        "graph.interrupts",
        "graph.retry_policy",
        "graph.metadata",
        "barrier.any_of",
        "retry_policy.per_node",
        "failure_edges",
        "failure_exits",
        "retry.attempt_timeout",
        "diagnostics.help",
        "diagnostics.echo_routes"
      ]
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "core_definition"],
      "properties": {
        "manifest": { "const": "https://neograph.dev/schemas/javascript-capability-manifest-v1.schema.json" },
        "core_definition": { "const": "https://neograph.dev/schemas/core-definition-v1.schema.json" }
      }
    },
    "dts_prelude": {
      "$ref": "#/$defs/text",
      "description": "TypeScript declarations the per-method dts signatures refer to."
    },
    "define": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "ng_properties", "ng_methods", "graph_builder_methods"],
      "properties": {
        "entry": { "$ref": "#/$defs/text" },
        "ng_properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "ng_methods": { "type": "array", "items": { "$ref": "#/$defs/builderMethod" } },
        "graph_builder_methods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/builderMethod" }
        }
      }
    },
    "main": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "ng_properties", "command_methods", "yield_contract"],
      "properties": {
        "entry": { "$ref": "#/$defs/text" },
        "ng_properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "command_methods": { "type": "array", "items": { "$ref": "#/$defs/method" } },
        "yield_contract": { "$ref": "#/$defs/text" }
      }
    },
    "structured_command_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_depth", "maximum_aggregate_members"],
      "properties": {
        "maximum_depth": { "$ref": "#/$defs/positive" },
        "maximum_aggregate_members": { "$ref": "#/$defs/positive" }
      }
    },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/text" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "kind": { "const": "constant" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "signature", "classification", "minimum_arity", "maximum_arity", "dts"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "signature": { "$ref": "#/$defs/text" },
        "classification": { "$ref": "#/$defs/text" },
        "minimum_arity": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "maximum_arity": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "dts": { "$ref": "#/$defs/text" }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "optional": { "type": "boolean" },
        "rest": { "type": "boolean" },
        "schema": {
          "type": "object",
          "description": "A JSON Schema (draft 2020-12) for this argument."
        }
      }
    },
    "builderMethod": {
      "allOf": [
        {
          "type": "object",
          "required": ["arguments", "feature"],
          "properties": {
            "arguments": { "type": "array", "items": { "$ref": "#/$defs/argument" } },
            "feature": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "signature", "classification", "minimum_arity", "maximum_arity", "dts"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
            "signature": { "$ref": "#/$defs/text" },
            "classification": { "$ref": "#/$defs/text" },
            "minimum_arity": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "maximum_arity": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "dts": { "$ref": "#/$defs/text" },
            "arguments": true,
            "feature": true
          }
        }
      ]
    }
  }
}
