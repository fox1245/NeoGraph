{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/program-synthesis-receipt-v1.schema.json",
  "title": "NeoGraph Program Synthesis Receipt v1",
  "type": "object",
  "required": ["format", "storage_schema_version", "id", "proposal_id", "reservation_id", "bundle_id", "program_version_id", "policy_snapshot_fingerprint"],
  "properties": {
    "format": { "const": "neograph-program-synthesis-receipt" },
    "storage_schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/sha256" },
    "proposal_id": { "$ref": "#/$defs/sha256" },
    "reservation_id": { "$ref": "#/$defs/sha256" },
    "bundle_id": { "$ref": "#/$defs/sha256" },
    "program_version_id": { "$ref": "#/$defs/sha256" },
    "policy_snapshot_fingerprint": { "$ref": "#/$defs/sha256" }
  },
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
