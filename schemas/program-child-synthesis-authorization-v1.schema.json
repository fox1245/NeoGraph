{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/program-child-synthesis-authorization-v1.schema.json",
  "title": "NeoGraph Child Synthesis Preflight Evidence v1",
  "description": "Read-only evidence binding a proposal and host grant to a parent snapshot. Not a compile reservation, child binding, or execution permit.",
  "type": "object",
  "required": ["format", "storage_schema_version", "id", "proposal_id", "grant_id", "parent_run_record_id", "parent_generation_id", "registry_fingerprint", "semantic_validator_identity", "semantic_contract_identity", "lineage_id", "source_lineage_head_id", "parent_remaining", "child_budget", "minimum_execution_guarantee"],
  "properties": {
    "format": {"const": "neograph-program-child-synthesis-authorization"},
    "storage_schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/sha256"},
    "proposal_id": {"$ref": "#/$defs/sha256"},
    "grant_id": {"$ref": "#/$defs/sha256"},
    "parent_run_record_id": {"$ref": "#/$defs/sha256"},
    "parent_generation_id": {"$ref": "#/$defs/sha256"},
    "registry_fingerprint": {"$ref": "#/$defs/sha256"},
    "semantic_validator_identity": {"$ref": "#/$defs/sha256"},
    "semantic_contract_identity": {"$ref": "#/$defs/sha256"},
    "lineage_id": {"$ref": "#/$defs/sha256"},
    "source_lineage_head_id": {"$ref": "#/$defs/sha256"},
    "parent_remaining": {"$ref": "#/$defs/budget"},
    "child_budget": {"$ref": "#/$defs/budget"},
    "minimum_execution_guarantee": {"enum": ["strict", "recorded", "unmanaged"]}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "budget": {
      "type": "object",
      "required": ["wall_time_ms", "model_tokens", "monetary_microunits", "max_concurrency", "max_program_operations", "max_core_steps", "max_dynamic_compiles", "max_child_depth", "max_total_children"],
      "properties": {
        "wall_time_ms": {"$ref": "#/$defs/u64"},
        "model_tokens": {"$ref": "#/$defs/u64"},
        "monetary_microunits": {"$ref": "#/$defs/u64"},
        "max_concurrency": {"$ref": "#/$defs/u32"},
        "max_program_operations": {"$ref": "#/$defs/u64"},
        "max_core_steps": {"$ref": "#/$defs/u64"},
        "max_dynamic_compiles": {"$ref": "#/$defs/u64"},
        "max_child_depth": {"$ref": "#/$defs/u32"},
        "max_total_children": {"$ref": "#/$defs/u64"}
      },
      "additionalProperties": false
    }
  }
}
