      "const": 3
    },
    "input_contract": {
      "$ref": "#/$defs/contract"
    },
    "output_contract": {
      "$ref": "#/$defs/contract"
    },
    "root": {
      "$ref": "#/$defs/root"
    },
    "declared_budget_requirements": {
      "$ref": "#/$defs/budget_requirements"
    }
  },
  "additionalProperties": false,
