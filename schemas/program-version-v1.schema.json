{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/program-version-v1.schema.json",
  "title": "NeoGraph ProgramVersion stored value v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "storage_schema_version",
    "id",
    "bundle_id",
    "admission_profile",
    "policy_snapshot",
    "dependency_receipts",
    "ownership_scope",
    "core_materialization_receipt"
  ],
  "properties": {
    "format": { "const": "neograph-program-version" },
    "storage_schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/sha256" },
    "bundle_id": { "$ref": "#/$defs/sha256" },
    "admission_profile": { "$ref": "admission-profile-v1.schema.json" },
    "policy_snapshot": { "$ref": "policy-snapshot-v1.schema.json" },
    "dependency_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependencyReceipt" }
    },
    "ownership_scope": { "$ref": "#/$defs/nonemptyString" },
    "core_materialization_receipt": { "$ref": "#/$defs/coreMaterializationReceipt" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "admission_profile": {
            "properties": {
              "allowed_effect_modes": { "contains": { "const": "trusted_native" } }
            },
            "required": ["allowed_effect_modes"]
          }
        },
        "required": ["admission_profile"]
      },
      "then": {
        "properties": {
          "policy_snapshot": {
            "properties": {
              "allowed_capabilities": {
                "contains": { "const": "neograph.native.trusted" }
              }
            },
            "required": ["allowed_capabilities"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "admission_profile": {
            "properties": {
              "allowed_effect_modes": {
                "not": { "contains": { "const": "trusted_native" } }
              }
            },
            "required": ["allowed_effect_modes"]
          }
        },
        "required": ["admission_profile"]
      },
      "then": {
        "properties": {
          "policy_snapshot": {
            "properties": {
              "allowed_capabilities": {
                "not": { "contains": { "const": "neograph.native.trusted" } }
              }
            },
            "required": ["allowed_capabilities"]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonemptyString": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u0020\\u007F](?:[^\\u0000-\\u001F\\u007F]*[^\\u0000-\\u0020\\u007F])?$"
    },
    "dependencyReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "content_identity"],
      "properties": {
        "dependency_id": { "$ref": "#/$defs/nonemptyString" },
        "content_identity": { "$ref": "#/$defs/sha256" }
      }
    },
    "corePlanIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "compiled_plan_identity"],
      "properties": {
        "name": { "$ref": "#/$defs/nonemptyString" },
        "compiled_plan_identity": { "$ref": "#/$defs/sha256" }
      }
    },
    "coreMaterializationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler_build_id", "registry_snapshot_fingerprint", "plans"],
      "properties": {
        "compiler_build_id": { "$ref": "#/$defs/nonemptyString" },
        "registry_snapshot_fingerprint": { "$ref": "#/$defs/sha256" },
        "plans": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/corePlanIdentity" }
        }
      }
    }
  }
}
