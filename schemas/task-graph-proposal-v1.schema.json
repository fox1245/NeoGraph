{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.ai/schemas/task-graph-proposal-v1.schema.json",
  "title": "NeoGraph TaskGraphProposal v1",
  "description": "Non-executable planner data. Structural validation is supplemented by the trusted template allow-list, DAG, binding, and budget checks in TaskGraphProposal::parse.",
  "type": "object",
  "required": ["schema_version", "tasks", "join"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "join": {"$ref": "#/$defs/join"}
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "json_pointer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/(?:[^~/]|~[01])*(?:/(?:[^~/]|~[01])*)*$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "model_tokens": {"type": "integer", "minimum": 0},
        "monetary_microunits": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "binding": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "object",
          "required": ["task", "artifact", "field"],
          "additionalProperties": false,
          "properties": {
            "task": {"$ref": "#/$defs/token"},
            "artifact": {"$ref": "#/$defs/token"},
            "field": {"$ref": "#/$defs/json_pointer"}
          }
        },
        "to": {
          "type": "object",
          "required": ["field"],
          "additionalProperties": false,
          "properties": {
            "field": {"$ref": "#/$defs/json_pointer"}
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "template", "input_bindings", "depends_on", "budget"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "template": {"$ref": "#/$defs/token"},
        "input_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/binding"}
        },
        "depends_on": {
          "type": "array",
          "items": {"$ref": "#/$defs/token"}
        },
        "budget": {"$ref": "#/$defs/budget"}
      }
    },
    "join": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "all"}
      }
    }
  }
}
