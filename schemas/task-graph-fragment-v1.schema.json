{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/task-graph-fragment-v1.schema.json",
  "title": "NeoGraph Task Graph Fragment Storage v1",
  "description": "Durable, typed, content-addressed task graph fragment and host-owned task state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storage_schema_version",
    "fragment",
    "tasks",
    "revision",
    "published",
    "terminal"
  ],
  "properties": {
    "storage_schema_version": { "const": 1 },
    "fragment": { "$ref": "#/$defs/compiled_fragment" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task_record" }
    },
    "revision": { "type": "integer", "minimum": 0 },
    "published": { "type": "boolean" },
    "terminal": { "type": "boolean" }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^(|(/([^~/]|~[01])*))+$/"
    },
    "source_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "json_pointer", "span"],
      "properties": {
        "source_id": { "type": "string" },
        "json_pointer": { "$ref": "#/$defs/json_pointer" },
        "span": {
          "anyOf": [
            { "type": "null" },
            { "type": "object" }
          ]
        }
      }
    },
    "source_map_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_pointer", "authored"],
      "properties": {
        "generated_pointer": { "$ref": "#/$defs/json_pointer" },
        "authored": { "$ref": "#/$defs/source_coordinate" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "model_tokens", "monetary_microunits", "output_bytes"],
      "properties": {
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "model_tokens": { "type": "integer", "minimum": 0 },
        "monetary_microunits": { "type": "integer", "minimum": 0 },
        "output_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task", "artifact", "field"],
          "properties": {
            "task": { "$ref": "#/$defs/token" },
            "artifact": { "$ref": "#/$defs/token" },
            "field": { "$ref": "#/$defs/json_pointer" }
          }
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": {
            "field": { "$ref": "#/$defs/json_pointer" }
          }
        }
      }
    },
    "compiled_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation_id",
        "template_id",
        "template_identity",
        "child_binding",
        "input_bindings",
        "depends_on",
        "budget",
        "reserved_budget",
        "capabilities",
        "effects"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "operation_id": { "$ref": "#/$defs/identity" },
        "template_id": { "$ref": "#/$defs/token" },
        "template_identity": { "$ref": "#/$defs/identity" },
        "child_binding": { "$ref": "#/$defs/token" },
        "input_bindings": { "type": "array", "items": { "$ref": "#/$defs/input_binding" } },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "budget": { "$ref": "#/$defs/budget" },
        "reserved_budget": { "$ref": "#/$defs/budget" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/token" } }
      }
    },
    "template_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "content_identity",
        "child_binding",
        "executable_identity",
        "kind",
        "capabilities",
        "effects"
      ],
      "properties": {
        "template_id": { "$ref": "#/$defs/token" },
        "content_identity": { "$ref": "#/$defs/identity" },
        "child_binding": { "$ref": "#/$defs/token" },
        "executable_identity": { "type": "string" },
        "kind": { "type": "string" },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/token" } }
      }
    },
    "compiled_fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "owner_scope",
        "parent_run_id",
        "expansion_operation_id",
        "parent_program_version_id",
        "child_depth",
        "proposal_hash",
        "tasks",
        "join",
        "aggregate_budget",
        "template_receipts",
        "capability_effect_closure",
        "fragment_id",
        "source_map"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "owner_scope": { "$ref": "#/$defs/token" },
        "parent_run_id": { "$ref": "#/$defs/token" },
        "expansion_operation_id": { "$ref": "#/$defs/token" },
        "parent_program_version_id": { "$ref": "#/$defs/token" },
        "child_depth": { "type": "integer", "minimum": 0 },
        "proposal_hash": { "$ref": "#/$defs/identity" },
        "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/compiled_task" } },
        "join": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "all" } }
        },
        "aggregate_budget": { "$ref": "#/$defs/budget" },
        "template_receipts": { "type": "array", "items": { "$ref": "#/$defs/template_receipt" } },
        "capability_effect_closure": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "fragment_id": { "$ref": "#/$defs/identity" },
        "source_map": { "type": "array", "items": { "$ref": "#/$defs/source_map_entry" } }
      }
    },
    "task_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "operation_id", "state", "attempt"],
      "properties": {
        "task_id": { "$ref": "#/$defs/token" },
        "operation_id": { "$ref": "#/$defs/identity" },
        "state": { "enum": ["pending", "active", "completed", "failed", "cancelled"] },
        "attempt": { "type": "integer", "minimum": 0 },
        "output": {},
        "failure": {}
      },
      "not": { "required": ["output", "failure"] }
    }
  }
}
