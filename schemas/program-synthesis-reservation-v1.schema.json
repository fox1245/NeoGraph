{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/program-synthesis-reservation-v1.schema.json",
  "title": "NeoGraph Program Synthesis Reservation v1",
  "type": "object",
  "required": ["format", "storage_schema_version", "id", "proposal_id", "lineage_id", "source_lineage_head_id", "reserved_lineage_head_id", "source_remaining", "remaining_after_reservation"],
  "properties": {
    "format": { "const": "neograph-program-synthesis-reservation" },
    "storage_schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/sha256" },
    "proposal_id": { "$ref": "#/$defs/sha256" },
    "lineage_id": { "$ref": "#/$defs/sha256" },
    "source_lineage_head_id": { "$ref": "#/$defs/sha256" },
    "reserved_lineage_head_id": { "$ref": "#/$defs/sha256" },
    "source_remaining": { "type": "object" },
    "remaining_after_reservation": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}

