{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/program-migration-plan-v2.schema.json",
  "title": "NeoGraph Program MigrationPlan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "storage_schema_version", "id", "source_version_id", "target_version_id", "owner_scope", "compatibility", "blockers", "diagnostics", "mappings"],
  "properties": {
    "format": {"const": "neograph-program-migration-plan"},
    "storage_schema_version": {"const": 2},
    "id": {"$ref": "#/$defs/identity"},
    "source_version_id": {"$ref": "#/$defs/identity"},
    "target_version_id": {"$ref": "#/$defs/identity"},
    "owner_scope": {"type": "string", "minLength": 1},
    "compatibility": {"enum": ["new_runs_only", "fork_compatible", "drain_only", "operator_reconciliation", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dimension": {"enum": ["channels", "continuation", "pending_input", "pending_effect", "retry", "cancellation", "interrupt", "budget", "authority", "checkpoint", "journal", "effects", "caches", "output", "compiler", "registry", "materialization", "contract", "recovery", "schema", "reducers", "barriers", "pending_work", "pending_events", "subscriptions", "resume", "node_local", "reconciliation", "terminal_output", "checkpoint_lineage"]},
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "code", "message", "source", "target"],
      "properties": {
        "dimension": {"$ref": "#/$defs/dimension"},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "source": {},
        "target": {}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "rule", "source", "target"],
      "properties": {
        "dimension": {"$ref": "#/$defs/dimension"},
        "rule": {"type": "string", "minLength": 1},
        "source": {},
        "target": {}
      }
    }
  }
}
