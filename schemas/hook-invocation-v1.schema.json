{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neograph.dev/schemas/hook-invocation-v1.schema.json",
  "title": "NeoGraph HookInvocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "id", "definition_id", "event_id", "target_id", "phase", "delivery", "failure_mode", "idempotency", "effect", "required_capabilities", "host_mapper_id", "arguments"],
  "properties": {
    "format": {"const": "neograph-hook-invocation"}, "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "definition_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["message_admitted", "before_provider_request", "after_provider_response", "before_tool_execution", "after_tool_execution", "checkpoint_published", "before_terminal_publication", "run_failed", "run_cancelled"]},
    "delivery": {"enum": ["blocking_mandatory", "durable_observational"]},
    "failure_mode": {"enum": ["fail_closed", "continue"]},
    "idempotency": {"enum": ["idempotent", "non_idempotent"]},
    "effect": {"enum": ["read_only", "external_read", "workspace_write", "external_write"]},
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "host_mapper_id": {"type": "string"}, "arguments": {}
  }
}
