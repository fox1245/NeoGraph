# Heavy artifacts / dependencies for the Jarvis cookbook. Never committed to git.
# Users download them directly via bash assets/download.sh or scripts/install_deps.sh.

# External libraries (~78MB) — ONNX Runtime, whisper.cpp, supertonic helper, miniaudio
third_party/

# Model weights (~1.9GB default with whisper-large-v3-turbo, or ~864MB with whisper-small) — supertonic-3, whisper, silero VAD, Moonshine
assets/onnx
assets/voices
assets/supertonic-3/
assets/whisper-small.bin
assets/silero_vad.onnx
assets/moonshine-tiny-ko/

# Demo outputs
*.wav
/tmp/

# Build artifacts (in case built inside the cookbook directory)
build/

# Jarvis conversation memory (file-persisted Store)
jarvis_memory.json
jarvis_memory.json.tmp
assets/whisper-large-v3-turbo.bin
