# Demo MCP server for E2E benchmarks (time/calculator/weather) — shared by both sides on the benchmark network
FROM python:3.12-slim
RUN pip install --no-cache-dir fastmcp
COPY examples/cookbook/jarvis/scripts/demo_mcp_server.py /srv/demo_mcp_server.py
EXPOSE 8888
CMD ["python3", "/srv/demo_mcp_server.py", "8888", "0.0.0.0"]
