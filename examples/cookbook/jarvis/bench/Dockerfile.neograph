# NeoGraph Jarvis benchmark image — mock build (no audio dependencies → STT passthrough / console TTS)
# Build context: NeoGraph repo root (.dockerignore excludes jarvis third_party/assets
# → CMake does not find whisper/onnx/miniaudio and automatically gates into mock mode)
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake make libssl-dev libcurl4-openssl-dev ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Jarvis does not use sqlite/postgres checkpoints, so set OFF — no container dev packages needed
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
        -DNEOGRAPH_BUILD_COOKBOOK_JARVIS=ON \
        -DNEOGRAPH_BUILD_SQLITE=OFF \
        -DNEOGRAPH_BUILD_POSTGRES=OFF \
    && cmake --build build --target cookbook_jarvis -j"$(nproc)" \
    && rm -rf build/CMakeFiles

ENV NEOGRAPH_BUILD_DIR=/src/build
WORKDIR /src/examples/cookbook/jarvis
