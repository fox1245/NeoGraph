# Copy to .env (alongside this file) and fill in.
#
# The example loads .env via cppdotenv. Existing process-env variables
# win — exporting OPENROUTER_API_KEY in your shell still takes precedence
# over the value below.

# ── Required ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Current Crawl4AI Docker releases require this non-empty bearer token before
# they expose the API outside the container. Generate it with: openssl rand -hex 32
CRAWL4AI_API_TOKEN=


# Default targets the docker-compose-managed Postgres on host port 55432.
# When running INSIDE the agent container, docker-compose.yml overrides
# this with the in-network address (postgres:5432) so this value is only
# used when you run the binary directly on the host.
POSTGRES_URL=postgresql://postgres:test@localhost:55432/neograph

# Native checkpoints require protected host custody, independent of PG JSON.
# Create the key parent once with `mkdir -m 700 .native-keys`, then run
# `example_postgres_react_hitl init-archive` once before run/resume.
# Compose overrides the paths with separate persistent private volume parents.
NEOGRAPH_NATIVE_ARCHIVE_DIR=.native-history
NEOGRAPH_NATIVE_ARCHIVE_KEY_FILE=.native-keys/archive.key
NEOGRAPH_NATIVE_ARCHIVE_OWNER=postgres-deep-research

# ── Optional ──────────────────────────────────────────────────────────

# Defaults to http://localhost:11235 when unset. Same override note as
# POSTGRES_URL: docker-compose flips this to http://crawl4ai:11235 in-network.
# CRAWL4AI_URL=http://localhost:11235

# SDK source for the named BuildKit context (Docker Compose >= 2.17).
# Path is relative to this Compose directory; override for another checkout.
SCHEMAPROVIDER_SOURCE=../../../SchemaProvider

# ── Postgres credentials (used by docker-compose to provision the DB) ─
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test
POSTGRES_DB=neograph
