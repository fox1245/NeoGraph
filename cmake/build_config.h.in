#pragma once
// Generated by CMake from cmake/build_config.h.in. Do not edit.
//
// NEOGRAPH_BUILD_THREADS is 1 when this NeoGraph was configured with NEOGRAPH_THREADS=ON (OS threads) and 0 for a
// single-thread build, the default on WebAssembly hosts.
#define NEOGRAPH_BUILD_THREADS @_neograph_build_threads@

// Sentinel. Asio is header-only: its classes and inline code differ between ASIO_DISABLE_THREADS and a threaded
// build, so two translation units of one program that disagree violate the one-definition rule and nothing
// diagnoses it. Every NeoGraph header reaches this one (through neograph/api.h), and a translation unit whose
// thread setting differs from the one recorded here stops compiling. The NeoGraph CMake targets export
// ASIO_DISABLE_THREADS in a single-thread build, so a CMake consumer agrees by construction; a consumer that builds
// its own flags has to agree explicitly. SchemaProvider records its own setting the same way (sp/build_config.h),
// and the two must agree.
#if NEOGRAPH_BUILD_THREADS
#  if defined(ASIO_DISABLE_THREADS)
#    error "NeoGraph was built with threads (NEOGRAPH_THREADS=ON) but this translation unit defines ASIO_DISABLE_THREADS: build both the same way"
#  endif
#  if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
#    error "NeoGraph was built with threads (NEOGRAPH_THREADS=ON) but this translation unit is compiled without -pthread: build both the same way"
#  endif
#else
#  if !defined(ASIO_DISABLE_THREADS)
#    error "NeoGraph was built without threads (NEOGRAPH_THREADS=OFF): define ASIO_DISABLE_THREADS in this translation unit (the NeoGraph CMake targets export it)"
#  endif
#  if defined(__EMSCRIPTEN_PTHREADS__)
#    error "NeoGraph was built without threads (NEOGRAPH_THREADS=OFF) but this translation unit is compiled with -pthread: build both the same way"
#  endif
#endif
