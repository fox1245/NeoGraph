# Copy to .env only for local use. Never commit a real credential.
# Optional python-dotenv loads the nearest example/repository .env.

# Hosted provider examples: 05, 06, 08, 11-13, 16-18, 21-23.
# Leave empty for offline examples or an explicitly configured loopback peer.
OPENAI_API_KEY=

# Optional origin or gateway prefix; omit the final /v1/... route.
# The endpoint must implement the selected Chat or Responses protocol.
# Default: https://api.openai.com
# OPENAI_API_BASE=https://api.openai.com
# No-key peer example (must be running; not an automatic fake provider):
# OPENAI_API_BASE=http://127.0.0.1:8080
# NG_EXAMPLE_CA_FILE=/path/to/local-peer-ca.pem
# NG_PROVIDER_DESCRIPTOR=/path/to/admitted-descriptor.json

# Optional — override the default model name.
# Default: gpt-4.1-mini. A local scripted peer may use its own model identifier.
# OPENAI_MODEL=gpt-4.1-mini
