{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fox1245.github.io/NeoGraph/spec/harness-dsl-coverage-v1.schema.json",
  "title": "NeoGraph bounded Harness DSL coverage inventory v1",
  "type": "object",
  "required": ["format", "source_commit", "entries"],
  "properties": {
    "format": {"const": "neograph-harness-dsl-coverage-v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "feature",
        "classification",
        "owner",
        "source_coordinates",
        "fixtures",
        "diagnostic_codes",
        "rationale"
      ],
      "properties": {
        "feature": {"type": "string", "minLength": 1},
        "classification": {
          "enum": [
            "supported",
            "language_gap",
            "sealed_primitive_gap",
            "runtime_contract_gap",
            "forbidden"
          ]
        },
        "owner": {"type": "string", "minLength": 1},
        "source_coordinates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[^:]+:.+$"}
        },
        "fixtures": {
          "type": "object",
          "required": ["positive", "negative"],
          "properties": {
            "positive": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[^.]+\\.[^.]+$"}
            },
            "negative": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[^.]+\\.[^.]+$"}
            }
          },
          "additionalProperties": false
        },
        "diagnostic_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
