{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fox1245.github.io/NeoGraph/spec/programmable-harness-compatibility-matrix-v1.schema.json",
  "title": "NeoGraph Programmable Harness Compatibility Matrix v1",
  "type": "object",
  "required": ["format", "entries"],
  "properties": {
    "format": {"const": "neograph-harness-compatibility-matrix-v1"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "required": [
        "id",
        "source_semantics_profile",
        "topology_features",
        "interaction_features",
        "registry_manifest_digest",
        "implementation_manifest_digest",
        "lowering_rule_digest",
        "classification",
        "oracle_coverage",
        "checkpoint_policy",
        "new_vm_admission"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_semantics_profile": {
          "enum": ["precutover-graph-engine-v1", "graph-compat-v1", "program-v1", "legacy-graph-v1-runtime"]
        },
        "topology_features": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "interaction_features": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "registry_manifest_digest": {"$ref": "#/$defs/digest"},
        "implementation_manifest_digest": {"$ref": "#/$defs/digest"},
        "lowering_rule_digest": {"$ref": "#/$defs/digest"},
        "classification": {
          "enum": ["equivalent", "versioned_change", "drain_only", "blocked"]
        },
        "oracle_coverage": {
          "type": "object",
          "required": ["fixture_ids", "property_suite_ids", "verified_at_commit"],
          "properties": {
            "fixture_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "property_suite_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "verified_at_commit": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "checkpoint_policy": {
          "type": "object",
          "required": ["classification", "schema_versions", "diagnostic_code"],
          "properties": {
            "classification": {"enum": ["convertible", "drain_only", "blocked", "not_applicable"]},
            "schema_versions": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
            "diagnostic_code": {"type": ["string", "null"]},
            "converter_id": {"type": ["string", "null"]},
            "runtime_digest": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "migration_diagnostic": {
          "type": "object",
          "required": ["code", "message", "target_profile"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "target_profile": {"type": ["string", "null"]},
            "migration_path": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "new_vm_admission": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "equivalent"}}, "required": ["classification"]},
          "then": {
            "properties": {
              "new_vm_admission": {"const": true},
              "oracle_coverage": {
                "properties": {
                  "fixture_ids": {"minItems": 1},
                  "verified_at_commit": {"type": "string", "minLength": 7}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"classification": {"enum": ["versioned_change", "drain_only", "blocked"]}}, "required": ["classification"]},
          "then": {"required": ["migration_diagnostic"]}
        },
        {
          "if": {"properties": {"classification": {"enum": ["drain_only", "blocked"]}}, "required": ["classification"]},
          "then": {"properties": {"new_vm_admission": {"const": false}}}
        }
      ],
      "additionalProperties": false
    }
  }
}
