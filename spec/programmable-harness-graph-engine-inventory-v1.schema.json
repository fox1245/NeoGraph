{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fox1245.github.io/NeoGraph/spec/programmable-harness-graph-engine-inventory-v1.schema.json",
  "title": "NeoGraph GraphEngine VM Migration Inventory v1",
  "type": "object",
  "required": ["format", "source_commit", "entries"],
  "properties": {
    "format": {"const": "neograph-graph-engine-migration-inventory-v1"},
    "source_commit": {"type": "string", "minLength": 7},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "method_id",
        "category",
        "current_backend",
        "target_owner",
        "setting_scope",
        "classification",
        "new_vm_admission",
        "before_cutover",
        "after_cutover",
        "verification"
      ],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "category": {"enum": ["construction", "execution", "administration", "mutable_policy"]},
        "current_backend": {"enum": ["graph_engine", "graph_compiler_and_engine", "scheduler_checkpoint", "post_build_mutation"]},
        "target_owner": {"enum": ["compiler", "control_vm", "durable_kernel", "deployment_binding", "compatibility_boundary"]},
        "setting_scope": {"enum": ["bundle_semantics", "admission_binding", "kernel_policy", "deployment_policy", "unsupported_post_admission_mutation", "not_applicable"]},
        "classification": {"enum": ["unclassified", "equivalent", "versioned_change", "drain_only", "blocked"]},
        "new_vm_admission": {"type": "boolean"},
        "before_cutover": {"type": "string", "minLength": 1},
        "after_cutover": {"type": "string", "minLength": 1},
        "diagnostic_code": {"type": ["string", "null"]},
        "verification": {
          "type": "object",
          "required": ["oracle_fixtures", "status"],
          "properties": {
            "oracle_fixtures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "status": {"enum": ["not_started", "partial", "verified"]}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"enum": ["unclassified", "drain_only", "blocked"]}}, "required": ["classification"]},
          "then": {"properties": {"new_vm_admission": {"const": false}}}
        },
        {
          "if": {"properties": {"classification": {"enum": ["versioned_change", "drain_only", "blocked"]}}, "required": ["classification"]},
          "then": {"required": ["diagnostic_code"]}
        }
      ],
      "additionalProperties": false
    }
  }
}
